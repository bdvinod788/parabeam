# Shared settings for CARC Discovery. Source this file; do not run it.
#
# Everything large lives on /scratch1, which has no backups and is purged when
# the file system passes 80% full. scripts/setup_env.sh and
# scripts/download_models.sh rebuild all of it.

_pb_repo="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"

export PB_SCRATCH="${PB_SCRATCH:-/scratch1/$USER/parabeam}"
export PB_ENV="$PB_SCRATCH/env"
export PB_MODELS="$PB_SCRATCH/models"
export PB_MODEL_LIST="${PB_MODEL_LIST:-$_pb_repo/configs/models.tsv}"

# /home1 has a fixed 100 GB quota, so caches stay on scratch.
export HF_HOME="$PB_SCRATCH/cache/huggingface"
export PIP_CACHE_DIR="$PB_SCRATCH/cache/pip"
export CONDA_PKGS_DIRS="$PB_SCRATCH/cache/conda"

export PB_PYTHON_VERSION=3.12
export PB_MPI_MODULES="gcc/13.3.0 openmpi/5.0.5"

# module purge, then load the arguments. Lmod is not always defined in
# non-interactive shells and does not run under `set -eu`, so this handles both
# and restores the caller's shell options.
pb_modules() {
    local flags="$-" rc
    set +eu
    type module >/dev/null 2>&1 || source /etc/profile
    module purge
    module load "$@"
    rc=$?
    [[ "$flags" == *e* ]] && set -e
    [[ "$flags" == *u* ]] && set -u
    return "$rc"
}
